# Evitar UTF-16 en Windows al editar requirements (pip/Docker requieren UTF-8).
requirements.txt text eol=lf working-tree-encoding=UTF-8
requirements-prod.txt text eol=lf working-tree-encoding=UTF-8
requirements-dev.txt text eol=lf working-tree-encoding=UTF-8

# Scripts shell: CRLF rompe shebang en Linux (exec: no such file or directory).
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

*.txt text eol=lf
Dockerfile text eol=lf